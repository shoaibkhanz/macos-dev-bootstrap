# =============================================================================
# Secrets File Template
# =============================================================================
# Copy this file to ~/.secrets and fill in your actual values.
# The ~/.secrets file is sourced by .zshrc automatically.
# NEVER commit your actual secrets file to version control!
# =============================================================================

# AI/LLM API Keys
# export OPENAI_API_KEY=""
# export ANTHROPIC_API_KEY=""
# export GEMINI_API_KEY=""

# Cloud Provider Credentials
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
# export AWS_DEFAULT_REGION="us-east-1"

# GitHub/GitLab Tokens
# export GITHUB_TOKEN=""
# export GITLAB_TOKEN=""

# Database URLs
# export DATABASE_URL=""

# Machine-local paths
# Not secrets, but they differ per machine, so they live here rather than in
# the tracked dotfiles. Point this at your Obsidian vault root, the directory
# holding .obsidian. The Claude and opencode Obsidian commands read it and fall
# back to ~/notes, which is almost certainly not where your vault is.
# export OBSIDIAN_VAULT="$HOME/code/obsidian/my-vault"

# Other secrets as needed
# export MY_SECRET=""
