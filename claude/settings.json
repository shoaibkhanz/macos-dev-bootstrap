{
  "agentPushNotifEnabled": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "devops-automation-pack@claude-code-plugins-plus": true,
    "everything-claude-code@everything-claude-code": true,
    "frontend-design@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "logfire@pydantic-skills": false,
    "lua-lsp@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "terraform-skill@antonbabenko": true
  },
  "extraKnownMarketplaces": {
    "everything-claude-code": {
      "source": {
        "repo": "affaan-m/everything-claude-code",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "async": false,
            "command": "~/.agents/hooks/session-start.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/shoaib/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "defaultMode": "auto"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "voiceEnabled": true
}